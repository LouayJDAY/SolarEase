# =============================================================================
# SolarEase backend -- example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Databases (one per microservice -- credentials shared for local dev only)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_real_env

# -----------------------------------------------------------------------------
# JWT (must be at least 256 bits / 32 characters for HS256)
# -----------------------------------------------------------------------------
APP_JWT_SECRET=change_me_to_a_strong_random_256_bit_secret_key_value
JWT_SECRET=change_me_to_a_strong_random_256_bit_secret_key_value
APP_JWT_EXPIRATION=86400000
APP_JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# Mail (Gmail SMTP -- use an App Password, never your real password)
# -----------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# -----------------------------------------------------------------------------
# Frontend URL (used by backend for CORS + email links)
# -----------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Ollama (local LLM runtime for AI recommendations -- RAG pipeline)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2:0.5b
OLLAMA_TIMEOUT_SECONDS=25

# -----------------------------------------------------------------------------
# Gemini Vision — fast invoice extraction (< 1 min). Get a free key at:
# https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Demo data seeder (set to "false" in production)
# -----------------------------------------------------------------------------
SOLAREASE_DEMO_SEED=true

# -----------------------------------------------------------------------------
# n8n — envoi automatique de facture par e-mail
# -----------------------------------------------------------------------------
N8N_ENABLED=true
N8N_INVOICE_WEBHOOK_URL=http://n8n:5678/webhook/solarease-invoice
N8N_INTERNAL_SECRET=change_me_n8n_secret
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
WEBHOOK_URL=http://localhost:5678/

# -----------------------------------------------------------------------------
# Service ports (defaults already correct -- override only if needed)
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
IDENTITY_PORT=8081
PROJECT_PORT=8082
DIMENSIONING_PORT=8083
