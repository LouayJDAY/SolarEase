@startuml uc-installateur-dimensionnement
title Raffinement -- Lancer le dimensionnement

left to right direction
skinparam shadowing false
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #2C5282
    ArrowColor      #2C5282
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor     #2C5282
}

actor "Installateur" as Installer

rectangle "Dimensionnement solaire" {
    usecase "Saisir les données\n(consommation, localisation)" as Input
    usecase "Lancer le calcul\nNight Panel" as Calc
    usecase "Consulter le résultat\n(kWc, panneaux, surface)" as Result
}

Installer --> Input
Installer --> Calc
Installer --> Result

@enduml
