@startuml uc-s3-global
title Diagramme de cas d'utilisation global -- Sprint 3

left to right direction
skinparam shadowing false
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #2C5282
    ArrowColor      #2C5282
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor     #2C5282
}

actor "Installateur" as Installer

rectangle "Dimensioning Service" {
    usecase "Lancer le dimensionnement\nNight Panel" as Calc
    usecase "Obtenir les\nrecommandations IA" as AI
    usecase "Télécharger le\nrapport PDF"     as PDF
}

Installer --> Calc
Installer --> AI
Installer --> PDF

@enduml
