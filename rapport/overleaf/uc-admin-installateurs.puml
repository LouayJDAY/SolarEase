@startuml uc-admin-installateurs
title Diagramme de cas d'utilisation -- Admin gère les Installateurs (Sprint 1)

left to right direction
skinparam shadowing false
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #2C5282
}
skinparam actor {
    BorderColor #2C5282
}

actor Admin

rectangle "Identity Service" {
    usecase "S'authentifier\n(Admin)"      as UC_Auth
    usecase "Consulter les\ninstallateurs" as UC_List
    usecase "Créer un\ninstallateur"       as UC_Create
    usecase "Modifier un\ninstallateur"    as UC_Update
    usecase "Supprimer un\ninstallateur"   as UC_Delete
}

Admin --> UC_Auth
Admin --> UC_List
Admin --> UC_Create
Admin --> UC_Update
Admin --> UC_Delete

UC_List   ..> UC_Auth : <<include>>
UC_Create ..> UC_Auth : <<include>>
UC_Update ..> UC_Auth : <<include>>
UC_Delete ..> UC_Auth : <<include>>

@enduml
