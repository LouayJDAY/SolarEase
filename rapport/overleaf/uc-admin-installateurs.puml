@startuml uc-admin-installateurs
title Diagramme de cas d'utilisation -- Admin gère les Installateurs (Sprint 1)

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor    #FAFAFA
    BorderColor        #2C5282
    ArrowColor         #2C5282
    FontName           "Helvetica"
}
skinparam actor {
    BackgroundColor    #E8F0FE
    BorderColor        #2C5282
}
skinparam note {
    BackgroundColor    #FFF8DC
    BorderColor        #B0BEC5
}

' ────────────────────────────────────────────
'  ACTEURS
' ────────────────────────────────────────────
actor "Admin"        as Admin
actor "Installateur" as Installer  <<actor secondaire>>
actor "Service\nE-mail (SMTP)" as Mailer <<système>>

' ────────────────────────────────────────────
'  PÉRIMÈTRE DU SYSTÈME
' ────────────────────────────────────────────
rectangle "Identity Service -- Gestion des Installateurs" {

    usecase "S'authentifier\n(Admin)"            as UC_Auth
    usecase "Lister les installateurs"           as UC_List
    usecase "Consulter\nun installateur"         as UC_View
    usecase "Créer un compte\ninstallateur"      as UC_Create
    usecase "Modifier un\ninstallateur"          as UC_Update
    usecase "Désactiver / supprimer\nun installateur" as UC_Delete
    usecase "Réinitialiser le\nmot de passe"     as UC_Reset
    usecase "Envoyer les identifiants\npar e-mail"     as UC_SendCreds
    usecase "Vérifier le rôle\nADMIN (JWT)"      as UC_CheckRole
    usecase "Valider les données\nsaisies"       as UC_Validate
}

' ────────────────────────────────────────────
'  ASSOCIATIONS ACTEUR -> CAS D'UTILISATION
' ────────────────────────────────────────────
Admin --> UC_Auth
Admin --> UC_List
Admin --> UC_View
Admin --> UC_Create
Admin --> UC_Update
Admin --> UC_Delete
Admin --> UC_Reset

' Installateur reçoit son compte (acteur secondaire)
UC_SendCreds  --> Installer
UC_Reset      ..> Installer  : notifie

' Mailer = système externe
UC_SendCreds  --> Mailer

' ────────────────────────────────────────────
'  RELATIONS INCLUDE / EXTEND
' ────────────────────────────────────────────
UC_List   ..> UC_Auth      : <<include>>
UC_View   ..> UC_Auth      : <<include>>
UC_Create ..> UC_Auth      : <<include>>
UC_Update ..> UC_Auth      : <<include>>
UC_Delete ..> UC_Auth      : <<include>>
UC_Reset  ..> UC_Auth      : <<include>>

UC_Auth   ..> UC_CheckRole : <<include>>

UC_Create ..> UC_Validate  : <<include>>
UC_Update ..> UC_Validate  : <<include>>

UC_Create ..> UC_SendCreds : <<include>>
UC_Reset  ..> UC_SendCreds : <<include>>

' ────────────────────────────────────────────
'  NOTES EXPLICATIVES
' ────────────────────────────────────────────
note right of UC_Create
  • Endpoint : POST /api/auth/installers
  • Compte créé déjà vérifié
    (isEmailVerified = true)
  • Pas de génération d'OTP
  • Mot de passe haché en BCrypt(10)
end note

note right of UC_CheckRole
  Le Gateway extrait du JWT
  l'en-tête X-User-Role.
  Si Role <> ADMIN -> HTTP 403
end note

note bottom of UC_Delete
  Suppression logique :
  passage du champ "actif"
  à false (préservation
  de l'historique des projets).
end note

@enduml
