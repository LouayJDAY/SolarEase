# Example environment variables for local development.
# Copy to .env and fill secrets before running `docker compose up`.

# Postgres (used by microservices)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Application / JWT
APP_JWT_SECRET=replace_with_secure_random_value
APP_FRONTEND_URL=http://localhost:5173

# Mail (used by services for sending emails)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-user@example.com
SPRING_MAIL_PASSWORD=your-smtp-password
SPRING_MAIL_FROM=invoices@yourcompany.com

# n8n (UI protection + webhook)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Africa/Tunis

# Optional: SMTP configuration to be used by the n8n Send Email node as a
# convenience. It's recommended to create an n8n Credential in the UI using
# these values (or use a dedicated SMTP user).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password

# Optional: n8n DB type (sqlite or postgres). Default: sqlite
N8N_DB_TYPE=sqlite

# Ports (optional overrides)
IDENTITY_PORT=8081
PROJECT_PORT=8082
GATEWAY_PORT=8080

# Do NOT commit real secrets to version control.